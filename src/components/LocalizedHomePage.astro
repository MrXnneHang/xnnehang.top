---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import Pagination from '../components/control/Pagination.astro'
import PostPage from '../components/PostPage.astro'
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales'
import MainGridLayout from '../layouts/MainGridLayout.astro'

interface Props {
  page: Page<CollectionEntry<'posts'>>
  locale?: Locale
}

const { page, locale = DEFAULT_LOCALE } = Astro.props
const len = page.data.length
---

<MainGridLayout locale={locale} showBanner={true}>
  <PostPage page={page} locale={locale} />
  <Pagination
    class="onload-animation mx-auto"
    page={page}
    locale={locale}
    style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
  />
</MainGridLayout>
