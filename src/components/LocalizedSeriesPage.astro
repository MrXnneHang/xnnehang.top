---
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '../i18n/locales'
import LocalizedCollectionPage from './LocalizedCollectionPage.astro'

interface Props {
  locale: Locale
  series: {
    name: string
    posts: CollectionEntry<'posts'>[]
  }
}

const { locale, series } = Astro.props
const description = locale === 'en'
  ? 'A reading path arranged as a continuing series.'
  : '沿着同一条持续展开的写作线索继续阅读。'
---

<LocalizedCollectionPage
  locale={locale}
  title={series.name}
  description={description}
  posts={series.posts}
/>
