---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'
import I18nKey from '../i18n/i18nKey'
import { type Locale } from '../i18n/locales'
import { createI18n } from '../i18n/translation'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { getPostRouteSlug } from '../utils/post-locale'
import { getPostUrlBySlug } from '../utils/url-utils'

interface Props {
  locale: Locale
  series: {
    name: string
    posts: CollectionEntry<'posts'>[]
  }
}

const { locale, series } = Astro.props
const t = createI18n(locale)
---

<MainGridLayout locale={locale} title={`${t(I18nKey.series)}: ${series.name}`} hideSidebar={true}>
  <h1 class="mb-6 text-2xl font-bold text-black/90 dark:text-white/90">{series.name}</h1>

  <div class="mb-4 flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 transition md:gap-4 md:bg-transparent md:py-0">
    {
      series.posts.map((entry, index) => (
        <PostCard
          entry={entry}
          title={entry.data.title}
          tags={entry.data.tags}
          category={entry.data.category}
          published={entry.data.published}
          updated={entry.data.updated}
          url={getPostUrlBySlug(getPostRouteSlug(entry), locale)}
          image={entry.data.image}
          description={entry.data.description}
          draft={entry.data.draft}
          locale={locale}
          class:list="onload-animation"
          style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms);`}
        />
      ))
    }
  </div>
</MainGridLayout>
