---
import ArchivePanel from '@components/ArchivePanel.svelte'
import I18nKey from '../i18n/i18nKey'
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales'
import { createI18n } from '../i18n/translation'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { getSortedPostsList } from '../utils/content-utils'

interface Props {
  locale?: Locale
}

const { locale = DEFAULT_LOCALE } = Astro.props
const t = createI18n(locale)
const sortedPostsList = await getSortedPostsList(locale)
---

<MainGridLayout locale={locale} title={t(I18nKey.archive)} hideSidebar={true}>
  <ArchivePanel
    sortedPosts={sortedPostsList}
    tags={[]}
    kinds={[]}
    locale={locale}
    client:only="svelte"
  />
</MainGridLayout>
