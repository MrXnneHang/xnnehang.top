---
import '@fontsource-variable/jetbrains-mono'
import '@fontsource-variable/jetbrains-mono/wght-italic.css'

interface Props {
  class: string
}
const className = Astro.props.class
---

<div
  data-pagefind-body
  class={`prose dark:prose-invert prose-base !max-w-none custom-md ${className}`}
>
  <!--<div class="prose dark:prose-invert max-w-none custom-md">-->
  <!--<div class="max-w-none custom-md">-->
  <slot />
</div>

<script>
  document.addEventListener('click', function (e: MouseEvent) {
    const target = e.target as Element | null
    if (target && target.classList.contains('copy-btn')) {
      const preEle = target.closest('pre')
      const codeEle = preEle?.querySelector('code')
      const code = Array.from(codeEle?.querySelectorAll('.code:not(summary *)') ?? [])
        .map((el) => el.textContent)
        .map((t) => (t === '\n' ? '' : t))
        .join('\n')
      navigator.clipboard.writeText(code)

      const timeoutId = target.getAttribute('data-timeout-id')
      if (timeoutId) {
        clearTimeout(parseInt(timeoutId))
      }

      target.classList.add('success')

      // 设置新的timeout并保存ID到按钮的自定义属性中
      const newTimeoutId = setTimeout(() => {
        target.classList.remove('success')
      }, 1000)

      target.setAttribute('data-timeout-id', newTimeoutId.toString())
    }
  })

  class ImageCompare extends HTMLElement {
    private range?: HTMLInputElement
    private toggle?: HTMLButtonElement
    private observer?: IntersectionObserver
    private sweepFrame?: number

    connectedCallback() {
      this.range = this.querySelector<HTMLInputElement>('.image-compare__range') ?? undefined
      this.toggle = this.querySelector<HTMLButtonElement>('.image-compare__toggle') ?? undefined
      if (!this.range || !this.toggle) return

      this.range.addEventListener('input', this.update)
      this.range.addEventListener('focus', this.cancelSweep)
      this.range.addEventListener('pointerdown', this.cancelSweep)
      this.range.addEventListener('keydown', this.cancelSweep)
      this.toggle.addEventListener('click', this.toggleCompare)
      this.setComparing(false)

      if (!this.hasAttribute('data-autoplay')) return
      this.observer = new IntersectionObserver(this.startSweep, { threshold: 0.6 })
      this.observer.observe(this)
    }

    disconnectedCallback() {
      this.range?.removeEventListener('input', this.update)
      this.range?.removeEventListener('focus', this.cancelSweep)
      this.range?.removeEventListener('pointerdown', this.cancelSweep)
      this.range?.removeEventListener('keydown', this.cancelSweep)
      this.toggle?.removeEventListener('click', this.toggleCompare)
      this.observer?.disconnect()
      if (this.sweepFrame) cancelAnimationFrame(this.sweepFrame)
    }

    private setComparing(comparing: boolean) {
      if (!this.range || !this.toggle) return
      this.classList.toggle('is-comparing', comparing)
      this.range.disabled = !comparing
      this.toggle.setAttribute('aria-pressed', String(comparing))
      this.toggle.setAttribute('aria-label', comparing ? '返回超分图' : '进入图片对比')
      if (comparing) this.update()
    }

    private update = () => {
      if (!this.range) return
      this.style.setProperty('--image-compare-position', `${this.range.value}%`)
      this.range.setAttribute('aria-valuetext', `${this.range.value}%`)
    }

    private toggleCompare = () => {
      this.cancelSweep()
      this.setComparing(!this.classList.contains('is-comparing'))
    }

    private startSweep = (entries: IntersectionObserverEntry[]) => {
      if (!entries.some((entry) => entry.isIntersecting)) return
      this.observer?.disconnect()
      this.setComparing(true)

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      const startedAt = performance.now()
      const keyframes = [50, 18, 82, 50]
      const offsets = [0, 0.2, 0.72, 1]
      const step = (now: number) => {
        const progress = Math.min((now - startedAt) / 1800, 1)
        const segment = offsets.findIndex((offset) => offset >= progress)
        const end = Math.max(1, segment)
        const local = (progress - offsets[end - 1]) / (offsets[end] - offsets[end - 1])
        const eased = 0.5 - Math.cos(local * Math.PI) / 2
        const position = keyframes[end - 1] + (keyframes[end] - keyframes[end - 1]) * eased
        this.style.setProperty('--image-compare-position', `${position}%`)
        if (progress < 1) this.sweepFrame = requestAnimationFrame(step)
        else {
          this.sweepFrame = undefined
          this.update()
        }
      }
      this.sweepFrame = requestAnimationFrame(step)
    }

    private cancelSweep = () => {
      this.observer?.disconnect()
      if (this.sweepFrame) cancelAnimationFrame(this.sweepFrame)
      this.sweepFrame = undefined
      this.update()
    }
  }

  if (!customElements.get('image-compare')) {
    customElements.define('image-compare', ImageCompare)
  }

  const fontStylesheetLoaders = {
    'noto-sans-sc': () => import('@fontsource-variable/noto-sans-sc/index.css?inline'),
    'lxgw-neo-xihei': () =>
      import('cn-fontsource-lxgw-neo-xi-hei-regular/font.css?inline'),
    'smiley-sans': async () => {
      const response = await fetch('/fonts/smiley-sans-v2/result.css')
      if (!response.ok) throw new Error('Failed to load Smiley Sans CSS')
      return {
        default: (await response.text()).replaceAll(
          'url("./',
          'url("/fonts/smiley-sans-v2/'
        ),
      }
    },
    'lxgw-wenkai-screen': () =>
      import('lxgw-wenkai-screen-web/lxgwwenkaiscreen/result.css?inline'),
  }

  function loadFontStylesheet(font: string, css: string) {
    const id = `font-lab-${font}`
    if (document.getElementById(id)) return

    const style = document.createElement('style')
    style.id = id
    style.textContent = css
    document.head.appendChild(style)
  }

  class FontLab extends HTMLElement {
    private specimen?: HTMLElement
    private status?: HTMLOutputElement
    private buttons: HTMLButtonElement[] = []
    private activeButton?: HTMLButtonElement

    connectedCallback() {
      this.specimen = this.querySelector<HTMLElement>('[data-font-specimen]') ?? undefined
      this.status = this.querySelector<HTMLOutputElement>('[data-font-status]') ?? undefined
      this.buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-font]'))
      if (!this.specimen || !this.status || this.buttons.length === 0) return

      this.buttons.forEach((button) => {
        button.disabled = false
        button.addEventListener('click', this.selectFont)
      })
      this.activeButton = this.buttons.find((button) => button.classList.contains('is-active'))
    }

    disconnectedCallback() {
      this.buttons.forEach((button) => button.removeEventListener('click', this.selectFont))
    }

    private setStatus(button: HTMLButtonElement, key: 'loading' | 'loaded' | 'unavailable' | 'error') {
      if (!this.status) return
      this.status.textContent = button.dataset[key] ?? ''
      this.status.dataset.state = key
    }

    private activate(button: HTMLButtonElement) {
      if (!this.specimen) return
      this.buttons.forEach((candidate) => {
        const active = candidate === button
        candidate.classList.toggle('is-active', active)
        candidate.setAttribute('aria-pressed', String(active))
      })
      this.activeButton = button
      this.specimen.style.fontFamily = button.dataset.fontFamily ?? ''
      this.dataset.activeFont = button.dataset.font ?? 'current'
    }

    private selectFont = async (event: Event) => {
      const button = event.currentTarget as HTMLButtonElement
      const font = button.dataset.font
      this.activate(button)

      if (font === 'current') {
        if (this.status) {
          this.status.textContent = this.status.defaultValue
          this.status.dataset.state = 'ready'
        }
        return
      }

      this.setStatus(button, 'loading')
      button.disabled = true
      try {
        const loader = fontStylesheetLoaders[font as keyof typeof fontStylesheetLoaders]
        if (loader) {
          const { default: css } = await loader()
          loadFontStylesheet(font ?? '', css)
        }
        const family = (button.dataset.fontFamily ?? '').split(',')[0]
        await document.fonts.load(`400 1em ${family}`, this.specimen?.textContent ?? '')
        this.setStatus(button, 'loaded')
      } catch {
        if (this.activeButton === button) {
          this.setStatus(button, 'error')
        }
      } finally {
        button.disabled = false
      }
    }
  }

  if (!customElements.get('font-lab')) {
    customElements.define('font-lab', FontLab)
  }
</script>
