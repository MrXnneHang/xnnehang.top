---
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '../i18n/locales'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import PostCardList from './PostCardList.astro'

interface Props {
  title: string
  description?: string
  posts: CollectionEntry<'posts'>[]
  locale: Locale
  secondaryUrl?: string
  secondaryLabel?: string
}

const {
  title,
  description = '',
  posts,
  locale,
  secondaryUrl,
  secondaryLabel,
} = Astro.props
const countLabel = locale === 'en'
  ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`
  : `${posts.length} 篇文章`
---

<MainGridLayout locale={locale} title={title} description={description}>
  <header class="card-base mb-4 rounded-[var(--radius-large)] p-6 md:p-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-black/90 dark:text-white/90">{title}</h1>
        {description && <p class="mt-3 max-w-2xl text-sm leading-6 text-black/50 dark:text-white/50">{description}</p>}
      </div>
      <div class="flex shrink-0 flex-col items-end gap-2">
        <span class="text-sm text-black/35 dark:text-white/35">{countLabel}</span>
        {secondaryUrl && secondaryLabel && <a href={secondaryUrl} class="link text-xs text-[var(--primary)]">{secondaryLabel} →</a>}
      </div>
    </div>
  </header>
  <PostCardList posts={posts} locale={locale} />
</MainGridLayout>
