---
import { getImage, type ImageMetadata } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { DEFAULT_LOCALE, ENGLISH_LOCALE, type Locale } from '../../i18n/locales'

interface Photo {
  src: ImageMetadata
  alt: string
  caption: string
  position?: string
}

interface Props {
  photos: Photo[]
  locale?: Locale
}

const { photos, locale = DEFAULT_LOCALE } = Astro.props
const labels = locale === ENGLISH_LOCALE
  ? {
      roledescription: 'photo carousel',
      group: `Reading portrait, ${photos.length} photos`,
      next: 'View the next reading portrait',
      full: (index: number, caption: string) => `View reading portrait ${index} in full: ${caption}`,
      fullTitle: 'View the complete photo on this site',
      previous: 'Previous reading portrait',
      dots: 'Choose a nearby reading portrait',
      dot: (index: number, caption = '') => `View photo ${index}${caption ? `: ${caption}` : ''}`,
      nextControl: 'Next reading portrait',
      more: 'More',
      expand: (caption: string) => `Read the full caption: ${caption}`,
      collapse: 'Close the full caption',
    }
  : {
      roledescription: '图片轮播',
      group: `阅读侧写，共 ${photos.length} 张`,
      next: '查看下一张阅读侧写',
      full: (index: number, caption: string) => `查看第 ${index} 张阅读侧写全图：${caption}`,
      fullTitle: '在站内查看完整照片',
      previous: '上一张阅读侧写',
      dots: '选择临近的阅读侧写',
      dot: (index: number, caption = '') => `查看第 ${index} 张${caption ? `：${caption}` : ''}`,
      nextControl: '下一张阅读侧写',
      more: '展开',
      expand: (caption: string) => `阅读完整说明：${caption}`,
      collapse: '关闭完整说明',
    }
const serializedLabels = JSON.stringify({
  next: labels.next,
  fullTemplate: labels.full(0, '{caption}').replace('0', '{index}'),
  dotTemplate: labels.dot(0, '{caption}').replace('0', '{index}'),
  expandTemplate: labels.expand('{caption}'),
  collapse: labels.collapse,
}).replaceAll('<', '\\u003c')
const renderedPhotos = await Promise.all(
  photos.map(async (photo) => ({
    ...photo,
    srcSet: await Promise.all(
      [640, 960, 1280].map((width) => getImage({ src: photo.src, width, format: 'webp' }))
    ),
  }))
)
const initialPhotos = renderedPhotos.slice(0, 3)
const photoData = JSON.stringify(
  renderedPhotos.map((photo) => ({
    alt: photo.alt,
    caption: photo.caption,
    position: photo.position ?? 'center',
    src: photo.srcSet[0].src,
    srcset: photo.srcSet.map((image) => `${image.src} ${image.attributes.width}w`).join(', '),
    width: photo.srcSet[0].attributes.width,
    height: photo.srcSet[0].attributes.height,
    fullSrc: photo.src.src,
    fullWidth: photo.src.width,
    fullHeight: photo.src.height,
  }))
).replaceAll('<', '\\u003c')
---

<about-photo-deck class="photo-deck" data-count={photos.length}>
  <div
    class="deck-stage"
    role="group"
    aria-roledescription={labels.roledescription}
    aria-label={labels.group}
    tabindex="0"
  >
    {
      initialPhotos.map((photo, slot) => (
        <figure
          class="deck-card"
          data-card
          data-slot={slot}
          data-position={slot}
          data-caption={photo.caption}
          aria-hidden={slot === 0 ? 'false' : 'true'}
          style={`--deck-position: ${slot}`}
        >
          <button
            class="photo-button"
            type="button"
            data-next
            aria-label={slot === 0 ? labels.next : undefined}
            tabindex={slot === 0 ? 0 : -1}
          >
            <img
              src={photo.srcSet[0].src}
              srcset={photo.srcSet.map((image) => `${image.src} ${image.attributes.width}w`).join(', ')}
              sizes="(max-width: 767px) 100vw, 58vw"
              width={photo.srcSet[0].attributes.width}
              height={photo.srcSet[0].attributes.height}
              alt={photo.alt}
              loading={slot === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="deck-image"
              style={`object-position: ${photo.position ?? 'center'}`}
            />
            <span class="photo-sheen" aria-hidden="true" />
          </button>
        </figure>
      ))
    }
    <span class="shelf-index" aria-hidden="true">READING PORTRAIT</span>
    <button
      class="photo-zoom"
      type="button"
      data-about-photo-preview
      aria-label={labels.full(1, photos[0]?.caption ?? '')}
      title={labels.fullTitle}
    >
      <Icon name="material-symbols:zoom-in-rounded" />
    </button>
  </div>

  <div class="deck-meta">
    <div class="caption-region">
      <p class="deck-caption" data-caption-output aria-live="polite">{photos[0]?.caption}</p>
      <button
        class="caption-more"
        type="button"
        data-caption-more
        aria-expanded="false"
        aria-controls="about-caption-preview"
        aria-label={labels.expand(photos[0]?.caption ?? '')}
      >
        {labels.more}
      </button>
      <div class="caption-preview" id="about-caption-preview" data-caption-preview hidden>
        <p data-caption-preview-output>{photos[0]?.caption}</p>
        <button type="button" data-caption-close aria-label={labels.collapse}>
          <Icon name="material-symbols:close-rounded" />
        </button>
      </div>
    </div>
    <div class="deck-controls">
      <button class="deck-arrow" type="button" data-prev aria-label={labels.previous}>
        <Icon name="material-symbols:arrow-back-rounded" />
      </button>
      <div class="deck-dots" role="group" aria-label={labels.dots}>
        {
          Array.from({ length: Math.min(4, photos.length) }, (_, index) => (
            <button
              class="deck-dot"
              type="button"
              data-dot={index}
              aria-label={labels.dot(index + 1)}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <span />
            </button>
          ))
        }
      </div>
      <span class="deck-count" aria-hidden="true"><b data-current>01</b> / {String(photos.length).padStart(2, '0')}</span>
      <button class="deck-arrow" type="button" data-next-control aria-label={labels.nextControl}>
        <Icon name="material-symbols:arrow-forward-rounded" />
      </button>
    </div>
  </div>
  <script type="application/json" data-photos set:html={photoData} />
  <script type="application/json" data-labels set:html={serializedLabels} />
</about-photo-deck>

<script>
  interface PhotoData {
    alt: string
    caption: string
    position: string
    src: string
    srcset: string
    width: number
    height: number
    fullSrc: string
    fullWidth: number
    fullHeight: number
  }

  interface DeckLabels {
    next: string
    fullTemplate: string
    dotTemplate: string
    expandTemplate: string
    collapse: string
  }

  class AboutPhotoDeck extends HTMLElement {
    private current = 0
    private cards: HTMLElement[] = []
    private dots: HTMLButtonElement[] = []
    private photos: PhotoData[] = []
    private labels: DeckLabels = {
      next: 'View the next photo',
      fullTemplate: 'View photo {index} in full: {caption}',
      dotTemplate: 'View photo {index}: {caption}',
      expandTemplate: 'Read the full caption: {caption}',
      collapse: 'Close the full caption',
    }
    private caption?: HTMLElement
    private captionMore?: HTMLButtonElement
    private captionPreview?: HTMLElement
    private captionPreviewOutput?: HTMLElement
    private captionClose?: HTMLButtonElement
    private captionResizeObserver?: ResizeObserver
    private currentOutput?: HTMLElement
    private zoomButton?: HTMLButtonElement

    connectedCallback() {
      this.cards = Array.from(this.querySelectorAll<HTMLElement>('[data-card]'))
      this.dots = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-dot]'))
      this.caption = this.querySelector<HTMLElement>('[data-caption-output]') ?? undefined
      this.captionMore = this.querySelector<HTMLButtonElement>('[data-caption-more]') ?? undefined
      this.captionPreview = this.querySelector<HTMLElement>('[data-caption-preview]') ?? undefined
      this.captionPreviewOutput = this.querySelector<HTMLElement>('[data-caption-preview-output]') ?? undefined
      this.captionClose = this.querySelector<HTMLButtonElement>('[data-caption-close]') ?? undefined
      this.currentOutput = this.querySelector<HTMLElement>('[data-current]') ?? undefined
      this.zoomButton = this.querySelector<HTMLButtonElement>('[data-about-photo-preview]') ?? undefined
      const photoData = this.querySelector<HTMLScriptElement>('[data-photos]')?.textContent
      const labelData = this.querySelector<HTMLScriptElement>('[data-labels]')?.textContent
      this.photos = photoData ? JSON.parse(photoData) : []
      if (labelData) this.labels = JSON.parse(labelData)

      this.querySelectorAll<HTMLElement>('[data-next]').forEach((button) => {
        button.addEventListener('click', this.next)
      })
      this.querySelector<HTMLElement>('[data-next-control]')?.addEventListener('click', this.next)
      this.querySelector<HTMLElement>('[data-prev]')?.addEventListener('click', this.previous)
      this.dots.forEach((dot) => dot.addEventListener('click', this.goToFromControl))
      this.zoomButton?.addEventListener('click', this.openPreview)
      this.captionMore?.addEventListener('click', this.openCaption)
      this.captionClose?.addEventListener('click', this.closeCaption)
      document.addEventListener('pointerdown', this.closeCaptionFromOutside)
      document.addEventListener('keydown', this.closeCaptionFromEscape)
      this.querySelector<HTMLElement>('.deck-stage')?.addEventListener('keydown', this.onKeydown)
      this.renderInstantly()
      this.captionResizeObserver = new ResizeObserver(this.updateCaptionOverflow)
      if (this.caption) this.captionResizeObserver.observe(this.caption)
      requestAnimationFrame(this.updateCaptionOverflow)
    }

    disconnectedCallback() {
      this.querySelectorAll<HTMLElement>('[data-next]').forEach((button) => {
        button.removeEventListener('click', this.next)
      })
      this.querySelector<HTMLElement>('[data-next-control]')?.removeEventListener('click', this.next)
      this.querySelector<HTMLElement>('[data-prev]')?.removeEventListener('click', this.previous)
      this.dots.forEach((dot) => dot.removeEventListener('click', this.goToFromControl))
      this.zoomButton?.removeEventListener('click', this.openPreview)
      this.captionMore?.removeEventListener('click', this.openCaption)
      this.captionClose?.removeEventListener('click', this.closeCaption)
      document.removeEventListener('pointerdown', this.closeCaptionFromOutside)
      document.removeEventListener('keydown', this.closeCaptionFromEscape)
      this.captionResizeObserver?.disconnect()
      this.querySelector<HTMLElement>('.deck-stage')?.removeEventListener('keydown', this.onKeydown)
    }

    private next = () => {
      if (this.photos.length < 2) return
      this.closeCaption()
      this.current = (this.current + 1) % this.photos.length

      const [front, middle, back] = [0, 1, 2].map((position) =>
        this.cards.find((card) => card.dataset.position === String(position))
      )
      if (!front || !middle || !back) return this.renderInstantly()

      this.replaceCard(front, (this.current + 2) % this.photos.length, 2)
      middle.dataset.position = '0'
      middle.style.setProperty('--deck-position', '0')
      back.dataset.position = '1'
      back.style.setProperty('--deck-position', '1')
      this.updateState()
    }

    private previous = () => {
      if (this.photos.length < 2) return
      this.closeCaption()
      this.current = (this.current - 1 + this.photos.length) % this.photos.length

      const [front, middle, back] = [0, 1, 2].map((position) =>
        this.cards.find((card) => card.dataset.position === String(position))
      )
      if (!front || !middle || !back) return this.renderInstantly()

      this.replaceCard(back, this.current, 0)
      front.dataset.position = '1'
      front.style.setProperty('--deck-position', '1')
      middle.dataset.position = '2'
      middle.style.setProperty('--deck-position', '2')
      this.updateState()
    }

    private goToFromControl = (event: Event) => {
      const index = Number((event.currentTarget as HTMLElement).dataset.go)
      if (Number.isNaN(index) || index === this.current) return
      if (index === (this.current + 1) % this.photos.length) return this.next()
      if (index === (this.current - 1 + this.photos.length) % this.photos.length) return this.previous()
      this.closeCaption()
      this.current = index
      this.renderInstantly()
    }

    private openCaption = () => {
      if (!this.captionPreview || !this.captionMore) return
      this.captionPreview.hidden = false
      this.captionMore.setAttribute('aria-expanded', 'true')
      this.captionClose?.focus()
    }

    private closeCaption = () => {
      if (!this.captionPreview || this.captionPreview.hidden) return
      this.captionPreview.hidden = true
      this.captionMore?.setAttribute('aria-expanded', 'false')
    }

    private closeCaptionFromOutside = (event: PointerEvent) => {
      if (!this.captionPreview || this.captionPreview.hidden) return
      if (!this.querySelector('.caption-region')?.contains(event.target as Node)) this.closeCaption()
    }

    private closeCaptionFromEscape = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || !this.captionPreview || this.captionPreview.hidden) return
      this.closeCaption()
      this.captionMore?.focus()
    }

    private updateCaptionOverflow = () => {
      if (!this.caption || !this.captionMore) return

      const measurement = this.caption.cloneNode(true) as HTMLElement
      measurement.removeAttribute('data-caption-output')
      measurement.style.position = 'absolute'
      measurement.style.visibility = 'hidden'
      measurement.style.width = `${this.caption.clientWidth}px`
      measurement.style.height = 'auto'
      measurement.style.overflow = 'visible'
      measurement.style.display = 'block'
      measurement.style.webkitLineClamp = 'unset'
      this.caption.parentElement?.append(measurement)
      const isOverflowing = measurement.scrollHeight > this.caption.clientHeight + 1
      measurement.remove()
      this.captionMore.hidden = !isOverflowing
    }

    private openPreview = () => {
      const photo = this.photos[this.current]
      const frontImage = this.querySelector<HTMLImageElement>('[data-position="0"] img')
      if (!photo) return

      document.dispatchEvent(
        new CustomEvent('about-photo:preview', {
          detail: {
            src: photo.fullSrc,
            width: photo.fullWidth,
            height: photo.fullHeight,
            msrc: frontImage?.currentSrc || photo.src,
            alt: photo.alt,
            caption: photo.caption,
          },
        })
      )
    }

    private onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault()
        this.next()
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault()
        this.previous()
      }
    }

    private renderInstantly() {
      this.cards.forEach((card, position) => {
        this.replaceCard(card, (this.current + position) % this.photos.length, position)
      })
      this.updateState()
    }

    private replaceCard(card: HTMLElement, photoIndex: number, position: number) {
      const photo = this.photos[photoIndex]
      const image = card.querySelector<HTMLImageElement>('img')
      if (!photo || !image) return

      card.dataset.resetting = 'true'
      card.dataset.photoIndex = String(photoIndex)
      card.dataset.position = String(position)
      card.dataset.caption = photo.caption
      card.style.setProperty('--deck-position', String(position))
      image.src = photo.src
      image.srcset = photo.srcset
      image.width = photo.width
      image.height = photo.height
      image.alt = photo.alt
      image.style.objectPosition = photo.position
      void card.offsetWidth
      delete card.dataset.resetting
    }

    private updateState() {
      this.cards.forEach((card) => {
        const active = card.dataset.position === '0'
        card.setAttribute('aria-hidden', active ? 'false' : 'true')
        const button = card.querySelector<HTMLButtonElement>('[data-next]')
        if (button) {
          button.tabIndex = active ? 0 : -1
          button.setAttribute('aria-label', active ? this.labels.next : '')
        }
      })

      const dotCount = this.dots.length
      const maxStart = Math.max(0, this.photos.length - dotCount)
      const start = Math.min(Math.max(this.current - 1, 0), maxStart)
      this.dots.forEach((dot, offset) => {
        const index = start + offset
        const photo = this.photos[index]
        dot.dataset.go = String(index)
        dot.setAttribute(
          'aria-label',
          this.labels.dotTemplate
            .replace('{index}', String(index + 1))
            .replace('{caption}', photo?.caption ?? '')
        )
        if (index === this.current) dot.setAttribute('aria-current', 'true')
        else dot.removeAttribute('aria-current')
      })

      const activePhoto = this.photos[this.current]
      if (this.caption && activePhoto) {
        this.caption.textContent = activePhoto.caption
        this.caption.title = activePhoto.caption
      }
      if (this.captionPreviewOutput && activePhoto) {
        this.captionPreviewOutput.textContent = activePhoto.caption
      }
      if (this.captionMore && activePhoto) {
        this.captionMore.setAttribute(
          'aria-label',
          this.labels.expandTemplate.replace('{caption}', activePhoto.caption)
        )
        requestAnimationFrame(this.updateCaptionOverflow)
      }
      if (this.zoomButton && activePhoto) {
        this.zoomButton.setAttribute(
          'aria-label',
          this.labels.fullTemplate
            .replace('{index}', String(this.current + 1))
            .replace('{caption}', activePhoto.caption)
        )
      }
      if (this.currentOutput) this.currentOutput.textContent = String(this.current + 1).padStart(2, '0')
    }
  }

  if (!customElements.get('about-photo-deck')) {
    customElements.define('about-photo-deck', AboutPhotoDeck)
  }
</script>

<style>
  .photo-deck {
    position: relative;
    z-index: 1;
    display: block;
    align-self: center;
    min-width: 0;
    padding: 0.9rem 1.15rem 0 0.35rem;
  }

  .deck-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    outline: none;
    perspective: 75rem;
  }

  .deck-stage:focus-visible {
    border-radius: 1.1rem;
    outline: 3px solid color-mix(in oklch, var(--primary) 45%, transparent);
    outline-offset: 5px;
  }

  .deck-card {
    --deck-offset-x: calc(var(--deck-position) * 0.52rem);
    --deck-offset-y: calc(var(--deck-position) * -0.42rem);
    --deck-rotation: calc((var(--deck-position) - 1) * 0.8deg);
    position: absolute;
    inset: 0;
    z-index: calc(10 - var(--deck-position));
    margin: 0;
    transform: translate(var(--deck-offset-x), var(--deck-offset-y)) rotate(var(--deck-rotation));
    transform-origin: 55% 90%;
    transition:
      transform 380ms cubic-bezier(0.2, 0.75, 0.25, 1),
      opacity 240ms ease,
      filter 240ms ease;
  }

  .deck-card[data-resetting='true'] {
    transition: none;
  }

  .deck-card[data-position='0'] {
    --deck-offset-x: 0rem;
    --deck-offset-y: 0rem;
    --deck-rotation: -0.7deg;
  }

  .deck-card[data-position='1'] {
    filter: saturate(0.92) brightness(0.96);
  }

  .deck-card[data-position='2'] {
    filter: saturate(0.82) brightness(0.91);
  }

  .photo-button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 0.35rem solid color-mix(in oklch, var(--card-bg) 92%, var(--primary));
    border-radius: 1.05rem;
    background: var(--btn-regular-bg);
    box-shadow:
      0 1.4rem 3rem rgb(25 35 45 / 16%),
      0 0 0 1px rgb(0 0 0 / 8%);
    cursor: pointer;
  }

  .deck-card:not([data-position='0']) .photo-button {
    pointer-events: none;
  }

  .photo-button:focus-visible {
    outline: 3px solid color-mix(in oklch, var(--primary) 55%, white);
    outline-offset: -0.55rem;
  }

  .deck-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-sheen {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 0.7rem;
    box-shadow: inset 0 -3rem 4rem rgb(22 28 35 / 6%);
    pointer-events: none;
  }

  .photo-zoom {
    position: absolute;
    right: 1rem;
    bottom: 0.8rem;
    z-index: 20;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid oklch(0.9 0.045 190 / 68%);
    border-radius: 1rem 1rem 1rem 0.45rem;
    background: oklch(0.68 0.07 190 / 58%);
    color: rgb(255 255 255 / 92%);
    box-shadow:
      0 0.45rem 1.1rem oklch(0.46 0.055 190 / 20%),
      inset 0 1px 0 rgb(255 255 255 / 34%);
    cursor: zoom-in;
    transform: rotate(-2deg);
    backdrop-filter: blur(8px);
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .photo-zoom:hover {
    transform: translateY(-1px) rotate(1deg) scale(1.06);
    background: oklch(0.62 0.08 190 / 72%);
  }

  .photo-zoom:active {
    transform: rotate(0deg) scale(0.94);
  }

  .photo-zoom:focus-visible {
    outline: 3px solid oklch(0.82 0.08 190 / 78%);
    outline-offset: 3px;
  }

  .photo-zoom :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .shelf-index {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    z-index: 20;
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    background: rgb(18 25 34 / 72%);
    color: rgb(255 255 255 / 88%);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    pointer-events: none;
    backdrop-filter: blur(8px);
  }

  .deck-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .caption-region {
    position: relative;
    min-width: 0;
  }

  .deck-caption {
    display: -webkit-box;
    min-width: 0;
    height: calc(1.55em * 2);
    margin: 0;
    overflow: hidden;
    color: rgb(100 100 100);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global(html.dark) .deck-caption {
    color: rgb(175 175 175);
  }

  .caption-more {
    position: absolute;
    right: 0;
    bottom: 0;
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    background: var(--card-bg);
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.55;
    box-shadow: -0.5rem 0 0.55rem var(--card-bg);
  }

  .caption-more[hidden],
  .caption-preview[hidden] {
    display: none;
  }

  .caption-more:hover {
    text-decoration: underline;
  }

  .caption-more:focus-visible,
  .caption-preview button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .caption-preview {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.55rem);
    left: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.65rem;
    border: 1px solid var(--line-divider);
    border-radius: 0.85rem;
    padding: 0.85rem;
    background: var(--card-bg);
    color: var(--deep-text);
    box-shadow: 0 0.85rem 2rem rgb(20 35 48 / 18%);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  :global(html.dark) .caption-preview {
    color: rgb(235 235 235);
    box-shadow: 0 0.85rem 2rem rgb(0 0 0 / 38%);
  }

  .caption-preview p {
    margin: 0;
