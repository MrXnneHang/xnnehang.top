---
import I18nKey from '../../i18n/i18nKey'
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales'
import { createI18n } from '../../i18n/translation'
import { getCategoryList } from '../../utils/content-utils'
import ButtonLink from '../control/ButtonLink.astro'
import WidgetLayout from './WidgetLayout.astro'

interface Props {
  class?: string
  style?: string
  locale?: Locale
}
const { class: className, style, locale = DEFAULT_LOCALE } = Astro.props
const t = createI18n(locale)
const categories = await getCategoryList(locale)

const COLLAPSED_HEIGHT = '7.5rem'
const COLLAPSE_THRESHOLD = 5
const isCollapsed = categories.length >= COLLAPSE_THRESHOLD
---

<WidgetLayout
  name={t(I18nKey.categories)}
  id="categories"
  isCollapsed={isCollapsed}
  collapsedHeight={COLLAPSED_HEIGHT}
  class={className}
  style={style}
  locale={locale}
>
  {
    categories.map((c) => (
      <ButtonLink
        url={c.url}
        badge={String(c.count)}
        label={`View all posts in the ${c.name.trim()} category`}
      >
        {c.name.trim()}
      </ButtonLink>
    ))
  }
</WidgetLayout>
