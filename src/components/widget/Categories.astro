---
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales'
import { getCategoryList } from '../../utils/content-utils'
import ButtonLink from '../control/ButtonLink.astro'
import WidgetLayout from './WidgetLayout.astro'

interface Props {
  class?: string
  style?: string
  locale?: Locale
}
const { class: className, style, locale = DEFAULT_LOCALE } = Astro.props
const labels =
  locale === 'en'
    ? { title: 'Collections', view: 'View all posts in' }
    : { title: '文集', view: '查看文集' }
const categories = await getCategoryList(locale)

const isCollapsed = false
---

<WidgetLayout
  name={labels.title}
  id="categories"
  isCollapsed={isCollapsed}
  class={className}
  style={style}
  locale={locale}
>
  {
    categories.map((c) => (
      <ButtonLink
        url={c.url}
        badge={String(c.count)}
        label={`${labels.view} ${c.name.trim()}`}
      >
        {c.name.trim()}
      </ButtonLink>
    ))
  }
</WidgetLayout>
