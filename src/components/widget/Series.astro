---
import I18nKey from '../../i18n/i18nKey'
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales'
import { createI18n } from '../../i18n/translation'
import { getSeriesList } from '../../utils/content-utils'
import { getSeriesUrl } from '../../utils/url-utils'
import ButtonLink from '../control/ButtonLink.astro'
import WidgetLayout from './WidgetLayout.astro'

interface Props {
  class?: string
  style?: string
  locale?: Locale
}
const { class: className, style, locale = DEFAULT_LOCALE } = Astro.props
const t = createI18n(locale)
const seriesList = await getSeriesList(locale)

const COLLAPSED_HEIGHT = '7.5rem'
const COLLAPSE_THRESHOLD = 5
const isCollapsed = seriesList.length >= COLLAPSE_THRESHOLD
---

<WidgetLayout
  name={t(I18nKey.series)}
  id="series"
  isCollapsed={isCollapsed}
  collapsedHeight={COLLAPSED_HEIGHT}
  class={className}
  style={style}
  locale={locale}
>
  {
    seriesList.map((s) => (
      <ButtonLink
        url={getSeriesUrl(s.name, locale)}
        badge={String(s.posts.length)}
        label={`View all posts in the ${s.name.trim()} series`}
      >
        {s.name.trim()}
      </ButtonLink>
    ))
  }
</WidgetLayout>
