---
import I18nKey from '../../i18n/i18nKey'
import { DEFAULT_LOCALE, type Locale } from '../../i18n/locales'
import { createI18n } from '../../i18n/translation'
import { getTagList } from '../../utils/content-utils'
import { getTagUrl } from '../../utils/url-utils'
import ButtonTag from '../control/ButtonTag.astro'
import WidgetLayout from './WidgetLayout.astro'

interface Props {
  class?: string
  style?: string
  locale?: Locale
}
const { class: className, style, locale = DEFAULT_LOCALE } = Astro.props
const t = createI18n(locale)
const tags = await getTagList(locale)

const COLLAPSED_HEIGHT = '7.5rem'
const isCollapsed = tags.length >= 20
---

<WidgetLayout
  name={t(I18nKey.tags)}
  id="tags"
  isCollapsed={isCollapsed}
  collapsedHeight={COLLAPSED_HEIGHT}
  class={className}
  style={style}
  locale={locale}
>
  <div class="flex flex-wrap gap-2">
    {
      tags.map((t) => (
        <ButtonTag href={getTagUrl(t.name, locale)} label={`View all posts with the ${t.name.trim()} tag`}>
          {t.name.trim()}
        </ButtonTag>
      ))
    }
  </div>
</WidgetLayout>
