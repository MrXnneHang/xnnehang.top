---
import path from 'node:path'
import License from '@components/misc/License.astro'
import Markdown from '@components/misc/Markdown.astro'
import I18nKey from '@i18n/i18nKey'
import { createI18n } from '@i18n/translation'
import MainGridLayout from '@layouts/MainGridLayout.astro'
import { getGitFileInfo } from '@utils/git-utils'
import type { LocalizedPostPageProps, RelatedPost } from '@utils/post-page'
import { getDir, getPostUrlBySlug, getSeriesUrl } from '@utils/url-utils'
import { Icon } from 'astro-icon/components'
import { licenseConfig, profileConfig } from '../config'
import ImageWrapper from './misc/ImageWrapper.astro'
import GraphView from './GraphView.svelte'
import Comments from './Comments.svelte'
import PostMetadata from './PostMeta.astro'
import { formatDateToYYYYMMDD } from '../utils/date-utils'
import { render } from 'astro:content'

const { entry, allPosts, relatedPosts, miniGraphData, locale } = Astro.props as LocalizedPostPageProps
const t = createI18n(locale)
const { Content, headings, remarkPluginFrontmatter } = await render(entry)

const gitInfo = getGitFileInfo(entry.filePath)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description || entry.data.title,
  keywords: entry.data.tags,
  author: {
    '@type': 'Person',
    name: profileConfig.name,
    url: Astro.site,
  },
  datePublished: formatDateToYYYYMMDD(entry.data.published),
  inLanguage: locale,
  // TODO include cover image here
}
---

<MainGridLayout
  banner={entry.data.image}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  locale={locale}
  setOGTypeArticle={true}
  headings={headings}
  hideSidebar={true}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="relative mb-4 flex w-full overflow-hidden rounded-[var(--radius-large)]">
    <div
      id="post-container"
      class:list={['card-base relative z-10 w-full px-6 pt-6 pb-4 md:px-9', {}]}
    >
      <!-- word count, reading time and git history -->
      <div
        class="onload-animation mb-3 flex flex-row flex-wrap gap-x-5 gap-y-2 text-black/30 transition dark:text-white/30"
      >
        <div class="flex flex-row items-center">
          <div
            class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50"
          >
            <Icon name="material-symbols:notes-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.words}
            {' ' + t(I18nKey.wordsCount)}
          </div>
        </div>
        <div class="flex flex-row items-center">
          <div
            class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50"
          >
            <Icon name="material-symbols:schedule-outline-rounded" />
          </div>
          <div class="text-sm">
            {remarkPluginFrontmatter.minutes}
            {
              ' ' +
                t(
                  remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount
                )
            }
          </div>
        </div>
        {
          gitInfo.lastModified && (
            <div class="flex flex-row items-center">
              <div class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50">
                <Icon name="material-symbols:update-rounded" />
              </div>
              <div class="text-sm">
                {t(I18nKey.lastEditedAt) + ' ' + formatDateToYYYYMMDD(gitInfo.lastModified)}
              </div>
            </div>
          )
        }
        {
          gitInfo.editCount > 0 && (
            <div class="flex flex-row items-center">
              <div class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50">
                <Icon name="material-symbols:history-rounded" />
              </div>
              <div class="text-sm">
                {gitInfo.editCount}
                {' ' + t(gitInfo.editCount === 1 ? I18nKey.revisionCount : I18nKey.revisionsCount)}
              </div>
            </div>
          )
        }
      </div>

      <!-- title -->
      <div class="onload-animation relative">
        <div
          data-pagefind-body
          data-pagefind-weight="10"
          data-pagefind-meta="title"
          class="text-90 mb-3 block w-full text-3xl font-bold transition before:absolute before:top-[0.75rem] before:left-[-1.125rem] before:h-5 before:rounded-md before:bg-[var(--primary)] md:text-[2.25rem]/[2.75rem] md:before:w-1"
        >
          {entry.data.title}
        </div>
      </div>

      <!-- metadata -->
      <div class="onload-animation">
        <PostMetadata
          class="mb-5"
          published={entry.data.published}
          updated={entry.data.updated}
          tags={entry.data.tags}
          category={entry.data.category}
          locale={locale}
        />
        {
          !entry.data.image && (
            <div class="mb-5 border-b-[1px] border-dashed border-[var(--line-divider)]" />
          )
        }
      </div>

      <!-- always show cover as long as it has one -->

      {
        entry.data.image && (
          <ImageWrapper
            id="post-cover"
            src={entry.data.image}
            basePath={path.join('content/posts/', getDir(entry.id))}
            class="banner-container onload-animation mb-8 rounded-xl"
          />
        )
      }

      <Markdown class="markdown-content onload-animation mb-6">
        <Content />
      </Markdown>

      {
        licenseConfig.enable && (
          <License
            title={entry.data.title}
            slug={entry.id}
            pubDate={entry.data.published}
            locale={locale}
            class="license-container onload-animation mb-6 rounded-xl"
          />
        )
      }

      <!-- series navigation -->
      {
        entry.data.series && entry.data.series.length > 0 && (() => {
          const AROUND_WINDOW = 5
          const seriesNames = entry.data.series || []
          return seriesNames.map((seriesName: string) => {
            const seriesPosts = allPosts
              .filter((post) => post.data.series && post.data.series.includes(seriesName))
              .sort((a, b) => {
                return new Date(a.data.published).getTime() - new Date(b.data.published).getTime()
              })
            const total = seriesPosts.length
            const currentIndex = seriesPosts.findIndex((post) => post.sourceId === entry.id)

            // Truncate to show posts around the current one
            const start = Math.max(0, currentIndex - AROUND_WINDOW)
            const end = Math.min(total, currentIndex + AROUND_WINDOW + 1)
            const visiblePosts = seriesPosts.slice(start, end)

            return (
              <div class="series-nav onload-animation card-base mb-4 rounded-2xl p-5">
                <div class="flex items-center justify-between">
                  <a
                    href={getSeriesUrl(seriesName, locale)}
                    class="text-sm font-bold uppercase tracking-wider text-[var(--primary)] transition hover:opacity-80"
                  >
                    {seriesName}
                  </a>
                  <span class="text-50 text-xs">{t(I18nKey.seriesPostCount).replace('{0}', String(total))}</span>
                </div>
                <ol class="mt-3 flex flex-col gap-1.5">
                  {start > 0 && (
                    <li class="text-center text-xs text-neutral-400">
                      <a href={getSeriesUrl(seriesName, locale)} class="hover:text-[var(--primary)]">{t(I18nKey.seriesCollapsedPrev).replace('{0}', String(start))}</a>
                    </li>
                  )}
                  {visiblePosts.map((post, index) => {
                    const isCurrent = post.sourceId === entry.id
                    const realIndex = start + index
                    return (
                      <li class:list={[{ 'text-[var(--primary)]': isCurrent }, 'transition']}>
                        <a
                          href={isCurrent ? undefined : getPostUrlBySlug(post.slug, locale)}
                          class:list={[
                            'flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm transition',
                            isCurrent
                              ? 'bg-[var(--primary)]/10 font-medium'
                              : 'hover:bg-black/5 dark:hover:bg-white/5',
                          ]}
                        >
                          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-black/5 text-xs text-black/50 dark:bg-white/10 dark:text-white/60">
                            {realIndex + 1}
                          </span>
                          <span class="truncate text-black/80 dark:text-white/80">{post.data.title}</span>
                          {isCurrent && <span class="ml-auto text-xs opacity-60">· {t(I18nKey.seriesCurrentLabel)}</span>}
                        </a>
                      </li>
                    )
                  })}
                  {end < total && (
                    <li class="text-center text-xs text-neutral-400">
                      <a href={getSeriesUrl(seriesName, locale)} class="hover:text-[var(--primary)]">{t(I18nKey.seriesCollapsedNext).replace('{0}', String(total - end))}</a>
                    </li>
                  )}
                </ol>
              </div>
            )
          })
        })()
      }

      <!-- related posts -->
      {
        relatedPosts.length > 0 && (
          <section class="related-posts onload-animation mb-4">
            <h2 class="mb-3 text-lg font-bold text-black/90 dark:text-white/90">{t(I18nKey.relatedPosts)}</h2>
            <div class="flex flex-col gap-3">
              {relatedPosts.map((p: RelatedPost) => {
                const img = p.firstImage || p.data.image || ''
                return (
                  <a
                    href={getPostUrlBySlug(p.slug, locale)}
                    class="card-base flex items-center gap-4 rounded-xl p-4 transition hover:bg-black/5 active:scale-[0.98] dark:hover:bg-white/5"
                  >
                    {img && (
                      <div class="h-16 w-24 shrink-0 overflow-hidden rounded-lg bg-black/5 dark:bg-white/5">
                        <ImageWrapper
                          src={img}
                          basePath={path.join('content/posts/', getDir(p.sourceId))}
                          alt=""
                          class="h-full w-full"
                        />
                      </div>
                    )}
                    <div class="flex min-w-0 flex-col gap-0.5">
                      <span class="truncate font-medium leading-snug text-black/80 dark:text-white/80">{p.data.title}</span>
                      <span class="text-50 shrink-0 text-xs">{formatDateToYYYYMMDD(p.data.published)}</span>
                    </div>
                  </a>
                )
              })}
            </div>
          </section>
        )
      }

      <!-- wiki link graph -->
      <section class="wiki-graph onload-animation mb-4">
        <div class="card-base overflow-hidden rounded-xl">
          <GraphView
            mode="mini"
            currentSlug={entry.data.translationKey || entry.id}
            graphData={miniGraphData}
            locale={locale}
            client:only="svelte"
          />
        </div>
      </section>

      <!-- comments -->
      <section class="comments onload-animation mb-4">
        <div class="card-base overflow-hidden rounded-xl">
          <Comments locale={locale} client:only="svelte" />
        </div>
      </section>
    </div>
  </div>

  <div class="mb-4 flex w-full flex-col justify-between gap-4 overflow-hidden md:flex-row">
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug, locale) : '#'}
      class:list={[
        'w-full overflow-hidden font-bold active:scale-95',
        { 'pointer-events-none': !entry.data.nextSlug },
      ]}
    >
      {
        entry.data.nextSlug && (
          <div class="btn-card flex h-[3.75rem] w-full max-w-full items-center !justify-start gap-4 rounded-2xl px-4">
            <Icon
              name="material-symbols:chevron-left-rounded"
              class="text-[2rem] text-[var(--primary)]"
            />
            <div class="max-w-[calc(100%_-_3rem)] overflow-hidden overflow-ellipsis whitespace-nowrap text-black/75 transition dark:text-white/75">
              {entry.data.nextTitle}
            </div>
          </div>
        )
      }
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug, locale) : '#'}
      class:list={[
        'w-full overflow-hidden font-bold active:scale-95',
        { 'pointer-events-none': !entry.data.prevSlug },
      ]}
    >
      {
        entry.data.prevSlug && (
          <div class="btn-card flex h-[3.75rem] w-full max-w-full items-center !justify-end gap-4 rounded-2xl px-4">
            <div class="max-w-[calc(100%_-_3rem)] overflow-hidden overflow-ellipsis whitespace-nowrap text-black/75 transition dark:text-white/75">
              {entry.data.prevTitle}
            </div>
            <Icon
              name="material-symbols:chevron-right-rounded"
              class="text-[2rem] text-[var(--primary)]"
            />
          </div>
        )
      }
    </a>
  </div>
</MainGridLayout>
