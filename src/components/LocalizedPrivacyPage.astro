---
import { getEntry, render } from 'astro:content'
import Markdown from '@components/misc/Markdown.astro'
import I18nKey from '../i18n/i18nKey'
import { DEFAULT_LOCALE, ENGLISH_LOCALE, type Locale } from '../i18n/locales'
import { createI18n } from '../i18n/translation'
import MainGridLayout from '../layouts/MainGridLayout.astro'

interface Props {
  locale?: Locale
}

const { locale = DEFAULT_LOCALE } = Astro.props
const t = createI18n(locale)
const privacyPage = await getEntry(
  'spec',
  locale === ENGLISH_LOCALE ? 'privacyen' : 'privacy'
)

if (!privacyPage) {
  throw new Error(`Privacy page content not found for locale: ${locale}`)
}

const { Content } = await render(privacyPage)
---

<MainGridLayout
  locale={locale}
  title={t(I18nKey.privacy)}
  description={t(I18nKey.privacy)}
  hideSidebar={true}
>
  <div class="relative flex min-h-32 w-full overflow-hidden rounded-[var(--radius-large)]">
    <div class="card-base relative z-10 w-full px-9 py-6">
      <Markdown class="mt-2">
        <Content />
      </Markdown>
    </div>
  </div>
</MainGridLayout>
