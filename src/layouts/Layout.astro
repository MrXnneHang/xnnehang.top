---
import '@fontsource/roboto/400.css'
import '@fontsource/roboto/500.css'
import '@fontsource/roboto/700.css'

import '../styles/main.css'
import '../styles/markdown.css'
import '../styles/expressive-code.css'
import '../styles/photoswipe.css'
import '../styles/scrollbar.css'
import '../styles/transition.css'

import ConfigCarrier from '@components/ConfigCarrier.astro'
import GoogleAnalytics from '@components/GoogleAnalytics.astro'
import { profileConfig, siteConfig } from '@/config'
import {
  AUTO_MODE,
  BANNER_HEIGHT,
  BANNER_HEIGHT_EXTEND,
  BANNER_HEIGHT_HOME,
  DARK_MODE,
  DEFAULT_THEME,
  LIGHT_MODE,
  PAGE_WIDTH,
} from '../constants/constants'
import {
  DEFAULT_LOCALE,
  getLocaleFromPathname,
  isLocaleHomePath,
  type Locale,
} from '../i18n/locales'
import { defaultFavicons } from '../constants/icon'
import type { Favicon } from '../types/config'
import { url } from '../utils/url-utils'
import 'katex/dist/katex.css'

interface Props {
  title?: string
  banner?: string
  description?: string
  lang?: string
  locale?: Locale
  setOGTypeArticle?: boolean
}

let { title, banner, description, lang, locale, setOGTypeArticle } = Astro.props
locale ??= getLocaleFromPathname(Astro.url.pathname)
locale ??= DEFAULT_LOCALE

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = isLocaleHomePath(Astro.url.pathname)

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue
if (!banner || typeof banner !== 'string' || banner.trim() === '') {
  banner = siteConfig.banner.src
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src

const enableBanner = siteConfig.banner.enable

let pageTitle: string
if (title) {
  pageTitle = `${title} - ${siteConfig.title}`
} else {
  pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`
}

const favicons: Favicon[] = siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
  lang = locale
}
const siteLang = lang.replace('_', '-')

const bannerOffsetByPosition = {
  top: `${BANNER_HEIGHT_EXTEND}vh`,
  center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
  bottom: '0',
}
const bannerOffset = bannerOffsetByPosition[siteConfig.banner.position || 'center']
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html
  lang={siteLang}
  class="theme-initializing overflow-x-hidden bg-[var(--page-bg)] text-[14px] transition md:text-[16px]"
  data-overlayscrollbars-initialize
>
  <head>
    <title>{pageTitle}</title>

    <meta charset="UTF-8" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description || pageTitle} />
    <meta name="author" content={profileConfig.name} />

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || pageTitle} />
    {
      setOGTypeArticle ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description || pageTitle} />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      favicons.map((favicon) => (
        <link
          rel="icon"
          href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
          sizes={favicon.sizes}
          media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
        />
      ))
    }

    <!-- Fix Tailwind's cascade layer order before code-split stylesheets load. -->
    <style is:inline>
      @layer theme, base, components, utilities;
    </style>
    <!-- Prevent the initial theme from transitioning from unloaded light colors. -->
    <style is:inline>
      html.theme-initializing,
      html.theme-initializing *,
      html.theme-initializing *::before,
      html.theme-initializing *::after {
        transition: none !important;
      }
    </style>
    <!-- Set the theme before the page is rendered to avoid a flash -->
    <script
      is:inline
      define:vars={{
        DEFAULT_THEME,
        LIGHT_MODE,
        DARK_MODE,
        AUTO_MODE,
        BANNER_HEIGHT_EXTEND,
        PAGE_WIDTH,
        configHue,
      }}
    >
      // Load the theme from local storage
      const theme = localStorage.getItem('theme') || DEFAULT_THEME
      switch (theme) {
        case LIGHT_MODE:
          document.documentElement.classList.remove('dark')
          break
        case DARK_MODE:
          document.documentElement.classList.add('dark')
          break
        case AUTO_MODE:
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark')
          } else {
            document.documentElement.classList.remove('dark')
          }
      }

      // Load the hue from local storage
      const hue = localStorage.getItem('hue') || configHue
      document.documentElement.style.setProperty('--hue', hue)

      // calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
      let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100))
      offset = offset - (offset % 4)
      document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`)

      const unlockThemeTransitions = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove('theme-initializing')
          })
        })
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', unlockThemeTransitions, { once: true })
      } else {
        unlockThemeTransitions()
      }
    </script>
    <style
      define:vars={{
        configHue,
        'page-width': `${PAGE_WIDTH}rem`,
      }}
    ></style>
    <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

    <slot name="head" />
    <GoogleAnalytics />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={profileConfig.name}
      href={new URL(url('rss.xml', locale), Astro.site).href}
    />
  </head>
  <body
    class="min-h-screen overflow-x-hidden transition"
    class:list={[{ 'lg:is-home': isHomePage, 'enable-banner': enableBanner }]}
    data-overlayscrollbars-initialize
  >
    <ConfigCarrier locale={locale} />
    <slot />

    <!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
    <div id="page-height-extend" class="hidden h-[300vh]"></div>
  </body>
</html>

<style
  is:global
  define:vars={{
    bannerOffset,
    'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
    'banner-height': `${BANNER_HEIGHT}vh`,
  }}
>
  @reference "../styles/main.css";
  @layer components {
    .enable-banner.is-home #banner-wrapper {
      @apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)];
    }
    .enable-banner #banner-wrapper {
      @apply h-[var(--banner-height-home)];
    }

    .enable-banner.is-home #banner {
      @apply h-[var(--banner-height-home)] translate-y-0;
    }
    .enable-banner #banner {
      @apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)];
    }
    .enable-banner.is-home #main-grid {
    }
    .enable-banner #top-row {
      @apply h-[calc(var(--banner-height)_-_4.5rem)] transition-all duration-300;
    }
    .enable-banner.is-home #sidebar-sticky {
      @apply top-[calc(1rem_-_var(--banner-height-extend))];
    }
    #navbar-wrapper.navbar-transparent .navbar-inner {
      background: transparent;
      box-shadow: none;
    }
    #navbar-wrapper.navbar-transparent .navbar-bg {
      opacity: 0;
    }
    #navbar-wrapper.navbar-opaque .navbar-inner {
      background: var(--card-bg);
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    }
    #navbar-wrapper.navbar-opaque .navbar-bg {
      opacity: 1;
    }
    #navbar-wrapper.navbar-hidden {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }
  }
</style>

<script>
  import 'overlayscrollbars/overlayscrollbars.css'
  import {
    OverlayScrollbars,
    // ScrollbarsHidingPlugin,
    // SizeObserverPlugin,
    // ClickScrollPlugin
  } from 'overlayscrollbars'
  import { isLocaleHomePath, isLocalePostPath } from '../i18n/locales'
  import { getHue, getStoredTheme, setHue, setTheme } from '../utils/setting-utils'
  import {
    BANNER_HEIGHT,
    BANNER_HEIGHT_EXTEND,
  } from '../constants/constants'
  import { siteConfig } from '../config'

  /* Preload fonts */
  // (async function() {
  // 	try {
  // 		await Promise.all([
  // 			document.fonts.load("400 1em Roboto"),
  // 			document.fonts.load("700 1em Roboto"),
  // 		]);
  // 		document.body.classList.remove("hidden");
  // 	} catch (error) {
  // 		console.log("Failed to load fonts:", error);
  // 	}
  // })();

  /* TODO This is a temporary solution for style flicker issue when the transition is activated */
  /* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
  /* update: fixed in Astro 3.2.4 */
  /*
function disableAnimation() {
	const css = document.createElement('style')
	css.appendChild(
		document.createTextNode(
			`*{
              -webkit-transition:none!important;
              -moz-transition:none!important;
              -o-transition:none!important;
              -ms-transition:none!important;
              transition:none!important
              }`
		)
	)
	document.head.appendChild(css)

	return () => {
		// Force restyle
		;(() => window.getComputedStyle(document.body))()

		// Wait for next tick before removing
		setTimeout(() => {
			document.head.removeChild(css)
		}, 1)
	}
}
*/

  const bannerEnabled = !!document.getElementById('banner-wrapper')

  function onSwupReady(callback: () => void) {
    if (window?.swup?.hooks) {
      callback()
      return
    }
    const id = setInterval(() => {
      if (window?.swup?.hooks) {
        clearInterval(id)
        callback()
      }
    }, 50)
  }

  function setClickOutsideToClose(panel: string, ignores: string[]) {
    document.addEventListener('click', (event) => {
      let panelDom = document.getElementById(panel)
      let tDom = event.target
      if (!(tDom instanceof Node)) return // Ensure the event target is an HTML Node
      for (let ig of ignores) {
        let ie = document.getElementById(ig)
        if (ie == tDom || ie?.contains(tDom)) {
          return
        }
      }
      panelDom!.classList.add('float-panel-closed')
    })
  }
  setClickOutsideToClose('display-setting', ['display-setting', 'display-settings-switch'])
  setClickOutsideToClose('nav-menu-panel', ['nav-menu-panel', 'nav-menu-switch'])
  setClickOutsideToClose('search-panel', ['search-panel', 'search-bar', 'search-switch'])

  function loadTheme() {
    const theme = getStoredTheme()
    setTheme(theme)
  }

  function loadHue() {
    setHue(getHue())
  }

  function initCustomScrollbar() {
    const bodyElement = document.querySelector('body')
    if (!bodyElement) return
    OverlayScrollbars(
      // docs say that a initialization to the body element would affect native functionality like window.scrollTo
      // but just leave it here for now
      {
        target: bodyElement,
        cancel: {
          nativeScrollbarsOverlaid: true, // don't initialize the overlay scrollbar if there is a native one
        },
      },
      {
        scrollbars: {
          theme: 'scrollbar-base scrollbar-auto py-1',
          autoHide: 'move',
          autoHideDelay: 500,
          autoHideSuspend: false,
        },
      }
    )

    const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>

    const katexObserverOptions = {
      root: null,
      rootMargin: '100px',
      threshold: 0.1,
    }

    const processKatexElement = (element: HTMLElement) => {
      if (!element.parentNode) return
      if (element.hasAttribute('data-scrollbar-initialized')) return

      const container = document.createElement('div')
      container.className = 'katex-display-container'
      container.setAttribute('aria-label', 'scrollable container for formulas')

      element.parentNode.insertBefore(container, element)
      container.appendChild(element)

      OverlayScrollbars(container, {
        scrollbars: {
          theme: 'scrollbar-base scrollbar-auto',
          autoHide: 'leave',
          autoHideDelay: 500,
          autoHideSuspend: false,
        },
      })

      element.setAttribute('data-scrollbar-initialized', 'true')
    }

    const katexObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          processKatexElement(entry.target as HTMLElement)
          observer.unobserve(entry.target)
        }
      })
    }, katexObserverOptions)

    katexElements.forEach((element) => {
      katexObserver.observe(element)
    })
  }

  function showBanner() {
    if (!siteConfig.banner.enable) return

    const banner = document.getElementById('banner')
    if (!banner) {
      console.error('Banner element not found')
      return
    }

    banner.classList.remove('opacity-0', 'scale-105')
  }

  function init() {
    // disableAnimation()()		// TODO
    loadTheme()
    loadHue()
    initCustomScrollbar()
    showBanner()
  }

  /* Load settings when entering the site */
  init()

  const setup = () => {
    // TODO: temp solution to change the height of the banner
    /*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
    window.swup.hooks.on('link:click', () => {
      // Remove the delay for the first time page load
      document.documentElement.style.setProperty('--content-delay', '0ms')
    })
    window.swup.hooks.on('content:replace', initCustomScrollbar)
    window.swup.hooks.on('visit:start', (visit: { to: { url: string } }) => {
      // change banner height immediately when a link is clicked
      const bodyElement = document.querySelector('body')
      if (isLocaleHomePath(new URL(visit.to.url, window.location.origin).pathname)) {
        bodyElement!.classList.add('lg:is-home')
      } else {
        bodyElement!.classList.remove('lg:is-home')
      }

      // increase the page height during page transition to prevent the scrolling animation from jumping
      const heightExtend = document.getElementById('page-height-extend')
      if (heightExtend) {
        heightExtend.classList.remove('hidden')
      }

      // Hide the TOC while scrolling back to top
      let toc = document.getElementById('toc-wrapper')
      if (toc) {
        toc.classList.add('toc-not-ready')
      }
    })
    window.swup.hooks.on('page:view', () => {
      // hide the temp high element when the transition is done
      const heightExtend = document.getElementById('page-height-extend')
      if (heightExtend) {
        heightExtend.classList.remove('hidden')
      }
    })
    window.swup.hooks.on('visit:end', (_visit: { to: { url: string } }) => {
      setTimeout(() => {
        const heightExtend = document.getElementById('page-height-extend')
        if (heightExtend) {
          heightExtend.classList.add('hidden')
        }

        // Just make the transition looks better
        const toc = document.getElementById('toc-wrapper')
        if (toc) {
          toc.classList.remove('toc-not-ready')
        }
      }, 200)
    })
  }
  if (window?.swup?.hooks) {
    setup()
  } else {
    onSwupReady(setup)
  }

  // Shared: update navbar transparent/opaque state based on page and scroll
  function updateNavbarState() {
    const navbarEl = document.getElementById('navbar-wrapper')
    if (!navbarEl) return
    const path = window.location.pathname
    const isHome = isLocaleHomePath(path)
    const scrollY = document.querySelector('[data-overlayscrollbars-viewport]')?.scrollTop || document.documentElement.scrollTop || 0
    const bannerMidpoint = window.innerHeight * (BANNER_HEIGHT / 100) / 2

    if (isHome && scrollY <= bannerMidpoint) {
      navbarEl.classList.add('navbar-transparent')
      navbarEl.classList.remove('navbar-opaque')
    } else {
      navbarEl.classList.remove('navbar-transparent')
      navbarEl.classList.add('navbar-opaque')
    }
  }

  // Sidebar and banner visibility: show only on homepage
  function updatePageLayout() {
    const path = window.location.pathname
    const isHome = isLocaleHomePath(path)
    const sidebar = document.getElementById('sidebar')
    const mainGrid = document.getElementById('main-grid')
    const bannerWrapper = document.getElementById('banner-wrapper')
    const mainContentPanel = document.getElementById('main-content-panel')

    if (sidebar) {
      sidebar.style.display = isHome ? '' : 'none'
    }
    if (mainGrid) {
      mainGrid.style.gridTemplateColumns = isHome ? '17.5rem auto' : 'auto'
    }
    if (bannerWrapper) {
      bannerWrapper.style.display = isHome ? '' : 'none'
    }
    if (mainContentPanel) {
      mainContentPanel.style.top = isHome ? 'calc(100vh + 2rem)' : '5.5rem'
    }
    if (isHome) {
      const banner = document.getElementById('banner')
      if (banner) {
        banner.classList.remove('opacity-0', 'scale-105')
      }
    }
    updateNavbarState()
    const navbarWrapper = document.getElementById('navbar-wrapper')
    if (navbarWrapper) {
      const isPost = isLocalePostPath(path)
      const currentScrollY = document.querySelector('[data-overlayscrollbars-viewport]')?.scrollTop || document.documentElement.scrollTop || 0
      if (isPost && currentScrollY > NAVBAR_HIDE_THRESHOLD) {
        navbarWrapper.classList.add('navbar-hidden')
      } else {
        navbarWrapper.classList.remove('navbar-hidden')
      }
    }
  }
  const NAVBAR_HIDE_THRESHOLD = 30
  updatePageLayout()
  if (window?.swup?.hooks) {
    window.swup.hooks.on('content:replace', updatePageLayout)
  } else {
    onSwupReady(() => {
      window.swup.hooks.on('content:replace', updatePageLayout)
    })
  }

  let backToTopBtn = document.getElementById('back-to-top-btn')
  let toc = document.getElementById('toc-wrapper')
  let navbar = document.getElementById('navbar-wrapper')
  function scrollFunction() {
    let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)
    const currentScrollY = document.querySelector('[data-overlayscrollbars-viewport]')?.scrollTop || document.documentElement.scrollTop || 0

    if (backToTopBtn) {
      if (currentScrollY > bannerHeight) {
        backToTopBtn.classList.remove('hide')
      } else {
        backToTopBtn.classList.add('hide')
      }
    }

    if (toc) {
      if (currentScrollY > window.innerHeight * 0.3) {
        toc.classList.remove('toc-hide')
      } else {
        toc.classList.add('toc-hide')
      }
    }

    if (navbar) {
      const isPost = isLocalePostPath(window.location.pathname)
      if (isPost && currentScrollY > NAVBAR_HIDE_THRESHOLD) {
        navbar.classList.add('navbar-hidden')
      } else {
        navbar.classList.remove('navbar-hidden')
      }
    }

    if (!bannerEnabled) return
    updateNavbarState()
  }
  window.onscroll = scrollFunction
  const osViewport = document.querySelector('[data-overlayscrollbars-viewport]')
  if (osViewport) {
    osViewport.addEventListener('scroll', scrollFunction, { passive: true })
  }

  window.onresize = () => {
    // calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
    let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100))
    offset = offset - (offset % 4)
    document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`)
  }
</script>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox'
  import 'photoswipe/style.css'

  interface AboutPhotoPreviewDetail {
    src: string
    width: number
    height: number
    msrc: string
    alt: string
    caption: string
  }

  let lightbox: PhotoSwipeLightbox
  let aboutLightbox: PhotoSwipeLightbox | undefined
  let pswp = import('photoswipe')

  const openAboutPhoto = (event: Event) => {
    const detail = (event as CustomEvent<AboutPhotoPreviewDetail>).detail
    if (!detail) return

    aboutLightbox?.destroy()
    aboutLightbox = new PhotoSwipeLightbox({
      pswpModule: () => pswp,
      closeSVG:
        '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
      zoomSVG:
        '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
      wheelToZoom: true,
      arrowPrev: false,
      arrowNext: false,
      imageClickAction: 'close',
      tapAction: 'close',
      doubleTapAction: 'zoom',
    })
    aboutLightbox.addFilter('pswpClass', (className) => `${className} pswp--about-photo`)
    aboutLightbox.on('uiRegister', () => {
      aboutLightbox?.pswp?.ui?.registerElement({
        name: 'aboutCaption',
        className: 'pswp__about-caption',
        appendTo: 'root',
        order: 8,
        html: '',
        onInit: (element) => {
          element.textContent = detail.caption
        },
      })
    })
    aboutLightbox.on('close', () => {
      aboutLightbox = undefined
    })
    aboutLightbox.loadAndOpen(0, [
      {
        src: detail.src,
        width: detail.width,
        height: detail.height,
        msrc: detail.msrc,
        alt: detail.alt,
      },
    ])
  }

  document.addEventListener('about-photo:preview', openAboutPhoto)

  function createPhotoSwipe() {
    lightbox = new PhotoSwipeLightbox({
      gallery: '.custom-md img:not([data-no-lightbox]), #post-cover img',
      pswpModule: () => pswp,
      closeSVG:
        '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
      zoomSVG:
        '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
      wheelToZoom: true,
      arrowPrev: false,
      arrowNext: false,
      imageClickAction: 'close',
      tapAction: 'close',
      doubleTapAction: 'zoom',
    })

    lightbox.addFilter('domItemData', (itemData, element) => {
      if (element instanceof HTMLImageElement) {
        itemData.src = element.src

        itemData.w = Number(element.naturalWidth || window.innerWidth)
        itemData.h = Number(element.naturalHeight || window.innerHeight)

        itemData.msrc = element.src
      }

      return itemData
    })

    lightbox.init()
  }

  const setup = () => {
    if (!lightbox) {
      createPhotoSwipe()
    }
    window.swup.hooks.on('page:view', () => {
      createPhotoSwipe()
    })

    window.swup.hooks.on(
      'content:replace',
      () => {
        lightbox?.destroy?.()
      },
      { before: true }
    )
  }

  if (window.swup) {
    setup()
  } else {
    const id = setInterval(() => {
      if (window?.swup?.hooks) {
        clearInterval(id)
        setup()
      }
    }, 50)
  }
</script>
