---
import { getEntry, render } from 'astro:content'
import Markdown from '@components/misc/Markdown.astro'
import I18nKey from '@i18n/i18nKey'
import { i18n } from '@i18n/translation'
import MainGridLayout from '@layouts/MainGridLayout.astro'

const privacyPost = await getEntry('spec', 'privacy')

if (!privacyPost) {
  throw new Error('Privacy page content not found')
}

const { Content } = await render(privacyPost)
---

<MainGridLayout
  title={i18n(I18nKey.privacy)}
  description={i18n(I18nKey.privacy)}
  hideSidebar={true}
>
  <div class="relative flex min-h-32 w-full overflow-hidden rounded-[var(--radius-large)]">
    <div class="card-base relative z-10 w-full px-9 py-6">
      <Markdown class="mt-2">
        <Content />
      </Markdown>
    </div>
  </div>
</MainGridLayout>
