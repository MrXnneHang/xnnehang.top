---
import type { GetStaticPaths } from 'astro'
import LocalizedSeriesPage from '../../components/LocalizedSeriesPage.astro'
import { DEFAULT_LOCALE } from '../../i18n/locales'
import { getSeriesList } from '../../utils/content-utils'

export const getStaticPaths = (async () => {
  const seriesList = await getSeriesList(DEFAULT_LOCALE)
  return seriesList.map((series) => ({
    params: { name: series.name },
    props: { series },
  }))
}) satisfies GetStaticPaths

const { series } = Astro.props
---

<LocalizedSeriesPage locale={DEFAULT_LOCALE} series={series} />
