---
import { Icon } from 'astro-icon/components'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { url } from '../utils/url-utils'
---

<MainGridLayout
  title="坐标未被记录"
  description="这片知识星球仍是一片荒漠，返回首页或前往文章归档继续探索。"
  hideSidebar={true}
>
  <section class="error-card card-base relative flex min-h-[34rem] w-full items-center justify-center px-6 py-12 md:px-12">
    <div class="error-grid" aria-hidden="true"></div>

    <div class="relative z-10 flex max-w-2xl flex-col items-center text-center">
      <div class="planet-scene mb-8" aria-hidden="true">
        <span class="orbit">
          <span class="satellite"></span>
        </span>
        <span class="planet">
          <span class="planet-shadow"></span>
          <span class="dune dune-back"></span>
          <span class="dune dune-front"></span>
        </span>
      </div>

      <p class="coordinate-label mb-3 text-xs font-bold tracking-[0.24em] text-[var(--primary)] uppercase">
        Coordinate not found
      </p>
      <h1 class="error-code text-90 text-[clamp(4.5rem,18vw,9rem)]/[0.85] font-bold tracking-[-0.08em]">
        404
      </h1>
      <h2 class="text-90 mt-7 text-2xl font-bold md:text-3xl">这片知识星球还是一片荒漠</h2>
      <p class="text-50 mt-4 max-w-lg leading-7">
        你抵达的坐标尚未被记录，也许页面已经迁徙到了别处。可以回到基地，或从文章归档重新开始探索。
      </p>

      <nav class="mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row" aria-label="404 页面导航">
        <a
          href={url('/')}
          class="primary-action flex h-12 items-center justify-center rounded-xl px-6 font-bold transition active:scale-95"
        >
          <Icon name="material-symbols:home-outline-rounded" class="mr-2 text-xl" />
          返回首页
        </a>
        <a
          href={url('/archive/')}
          class="secondary-action btn-regular flex h-12 items-center justify-center rounded-xl px-6 font-bold active:scale-95"
        >
          <Icon name="material-symbols:archive-outline-rounded" class="mr-2 text-xl" />
          查看归档
        </a>
      </nav>
    </div>
  </section>
</MainGridLayout>

<style>
  .error-card {
    isolation: isolate;
    border: 1px solid color-mix(in oklch, var(--primary) 10%, transparent);
  }

  .error-card::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 50% 12%, color-mix(in oklch, var(--primary) 16%, transparent), transparent 34%),
      linear-gradient(to bottom, transparent 64%, color-mix(in oklch, var(--primary) 6%, transparent));
    content: '';
  }

  .error-grid {
    position: absolute;
    inset: 56% -12% -25%;
    opacity: 0.4;
    background-image:
      linear-gradient(color-mix(in oklch, var(--primary) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklch, var(--primary) 12%, transparent) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: linear-gradient(to bottom, transparent, black 24%, transparent 82%);
    transform: perspective(18rem) rotateX(64deg) scale(1.3);
    transform-origin: center top;
  }

  .planet-scene {
    position: relative;
    display: grid;
    width: 8.5rem;
    height: 8.5rem;
    place-items: center;
  }

  .planet {
    position: relative;
    display: block;
    width: 6.25rem;
    height: 6.25rem;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--primary) 45%, transparent);
    border-radius: 9999px;
    background: color-mix(in oklch, var(--primary) 12%, var(--card-bg));
    box-shadow:
      0 0 0 0.5rem color-mix(in oklch, var(--primary) 5%, transparent),
      0 1.25rem 3rem color-mix(in oklch, var(--primary) 18%, transparent);
  }

  .planet-shadow {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 42%, color-mix(in oklch, var(--page-bg) 82%, transparent) 74%);
  }

  .dune {
    position: absolute;
    left: -15%;
    width: 130%;
    border-radius: 50% 50% 0 0;
    background: color-mix(in oklch, var(--primary) 38%, var(--card-bg));
    transform: rotate(-8deg);
  }

  .dune-back {
    bottom: 0.85rem;
    height: 2.5rem;
    opacity: 0.65;
  }

  .dune-front {
    right: -20%;
    bottom: -0.75rem;
    left: auto;
    height: 3.25rem;
    background: color-mix(in oklch, var(--primary) 58%, var(--card-bg));
    transform: rotate(9deg);
  }

  .orbit {
    position: absolute;
    inset: 0;
    border: 1px dashed color-mix(in oklch, var(--primary) 34%, transparent);
    border-radius: 9999px;
    animation: orbit 14s linear infinite;
  }

  .satellite {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    width: 0.65rem;
    height: 0.65rem;
    border: 2px solid var(--card-bg);
    border-radius: 9999px;
    background: var(--primary);
    box-shadow: 0 0 1rem color-mix(in oklch, var(--primary) 70%, transparent);
  }

  .error-code {
    text-shadow: 0 0.08em 0 color-mix(in oklch, var(--primary) 22%, transparent);
  }

  .primary-action {
    background: var(--primary);
    color: var(--deep-text);
  }

  .primary-action:hover {
    filter: brightness(1.05);
  }

  .primary-action:focus-visible,
  .secondary-action:focus-visible {
    outline: 3px solid color-mix(in oklch, var(--primary) 55%, transparent);
    outline-offset: 3px;
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit {
      animation: none;
    }
  }
</style>
